# Required: key for Meta Muse Spark and Muse Voice Transcribe.
MODEL_API_KEY=

# Required: a random secret for Flask sessions.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional: IANA timezone for this single-user MAVIS instance.
# New Jersey and New York use this same Eastern Time zone (EST/EDT).
MAVIS_TIMEZONE=America/New_York

# Optional: only needed to run test_baseten_connection.py.
# The main application uses Meta's API, not Baseten, for reasoning.
BASETEN_API_KEY=
